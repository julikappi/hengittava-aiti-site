{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "materiaalit/**"
      }
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/materiaalit/(.*)",
      "status": 404
    },
    {
      "src": "/public/materiaalit/(.*)",
      "status": 404
    },
    {
      "src": "^/hermosto-reset-viikko-1/?$",
      "status": 302,
      "headers": {
        "Location": "https://sites.leadconnectorhq.com/preview/uq6JC6cu8w0iri3DmvfS"
      }
    },
    {
      "src": "^/tietosuojaseloste/?$",
      "status": 302,
      "headers": {
        "Location": "https://sites.leadconnectorhq.com/preview/S1YMcelSBsAUe9eNKTqH"
      }
    },
    {
      "src": "/hermosto-reset/?",
      "dest": "/hermosto-reset/index.html"
    },
    {
      "src": "/minun-tarinani/?",
      "dest": "/minun-tarinani/index.html"
    },
    {
      "src": "/kauppa/hermosto-reset/?",
      "status": 302,
      "headers": {
        "Location": "https://buy.stripe.com/cNi14nb7O7BZf573np1Fe02"
      }
    },
    {
      "src": "/opas/?",
      "status": 302,
      "headers": {
        "Location": "https://hengittava-aiti.fi/hermosto-reset-viikko-1"
      }
    },
    {
      "src": "/kiitos/kun-huusit/?",
      "dest": "/kiitos/kun-huusit/index.html"
    },
    {
      "src": "/kiitos/opas/?",
      "dest": "/kiitos/opas/index.html"
    },
    {
      "src": "/kiitos/musiikki/?",
      "dest": "/kiitos/musiikki/index.html"
    },
    {
      "src": "/kiitos/hermosto-reset-21/?",
      "dest": "/kiitos/hermosto-reset-21/index.html"
    },
    {
      "src": "/tietosuoja/?",
      "dest": "/tietosuoja/index.html"
    },
    {
      "src": "/ostoehdot/?",
      "dest": "/ostoehdot/index.html"
    },
    {
      "src": "/visuaalinen-ohjeistus/?",
      "dest": "/visuaalinen-ohjeistus/index.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
