{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/hermosto-reset/?", "dest": "/hermosto-reset/index.html" },
    { "src": "/kauppa/hermosto-reset/?", "dest": "/kauppa/hermosto-reset/index.html" },
    { "src": "/kiitos/opas/?", "dest": "/kiitos/opas/index.html" },
    { "src": "/kiitos/musiikki/?", "dest": "/kiitos/musiikki/index.html" },
    { "src": "/kiitos/hermosto-reset-21/?", "dest": "/kiitos/hermosto-reset-21/index.html" },
    { "src": "/tietosuoja/?", "dest": "/tietosuoja/index.html" },
    { "src": "/ostoehdot/?", "dest": "/ostoehdot/index.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
